# Official generated artifacts; release notes are authored in docs/release-notes.
/release/
# Disposable compilation environments, caches, onedir bundles and unsigned staging.
/build/
/dist/
**/__pycache__/
*.py[cod]

# Aggregator output written next to the bundled sample data during testing
sample_data/*_aggregated_*.xlsx
sample_data/*_aggregated_*.csv

scratch/

